---
export interface Props {
  project: {
    slug: string;
    data: {
      title: string;
      category: string;
      excerpt: string;
      thumbnail?: string;
      githubUrl: string;
      stars: number;
      language?: string;
      featured?: boolean;
      tags?: string[];
    };
  };
}

const { project } = Astro.props;
const { title, category, excerpt, thumbnail, githubUrl, stars, language, featured, tags } = project.data;
---

<article class="group relative bg-dark-surface border border-border rounded-xl overflow-hidden hover:border-amber/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-amber/5">
  {featured && (
    <div class="absolute top-3 right-3 z-10 px-2 py-1 bg-amber/10 border border-amber/20 rounded text-xs font-mono text-amber">
      Featured
    </div>
  )}
  
  <!-- Thumbnail -->
  <a href={`/projects/${project.slug}/`} class="block aspect-video bg-dark-elevated overflow-hidden">
    <img 
      src={thumbnail || '/default-thumbnail.png'} 
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
  </a>
  
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-mono text-amber">{category}</span>
      {language && (
        <span class="text-xs text-text-muted">· {language}</span>
      )}
    </div>
    
    <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-amber transition-colors">
      <a href={`/projects/${project.slug}/`}>{title}</a>
    </h3>
    
    <p class="text-sm text-text-secondary line-clamp-2 mb-4">
      {excerpt}
    </p>
    
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-xs bg-dark-elevated border border-border rounded text-text-muted">
            {tag}
          </span>
        ))}
      </div>
    )}
    
    <div class="flex items-center justify-between pt-3 border-t border-border">
      <a 
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-sm text-text-muted hover:text-amber transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Source</span>
      </a>
      
      {stars > 0 && (
        <div class="flex items-center gap-1 text-sm text-text-muted">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span>{stars}</span>
        </div>
      )}
    </div>
  </div>
</article>
