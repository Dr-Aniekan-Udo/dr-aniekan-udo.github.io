---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, category, description, excerpt, thumbnail, githubUrl, stars, language, tags, techStack, status, liveDemo, features } = project.data;
---

<BaseLayout title={`${title} — Aniekan Udo`} description={excerpt}>
  <Navigation />
  
  <main class="pt-24 pb-16 section-padding">
    <div class="content-max">
      <div class="reveal mb-8">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-amber transition-colors mb-6"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Projects
        </a>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main content -->
        <div class="lg:col-span-2">
          <div class="reveal">
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <span class="text-amber font-mono text-sm">{category}</span>
              {language && (
                <span class="text-text-muted text-sm">· {language}</span>
              )}
              {status && status !== "Unknown" && (
                <span class={`text-xs px-2 py-0.5 rounded-full border ${
                  status === "Active" ? "border-green-500/30 text-green-400 bg-green-500/10" :
                  status === "Complete" ? "border-amber/30 text-amber bg-amber/10" :
                  "border-text-muted/30 text-text-muted bg-dark-elevated"
                }`}>
                  {status}
                </span>
              )}
            </div>
            
            <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">{title}</h1>
            
            <p class="text-text-secondary text-lg leading-relaxed mb-6">
              {excerpt}
            </p>
            
            {techStack && techStack.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-8">
                {techStack.map((tech) => (
                  <span class="px-3 py-1 text-xs bg-dark-elevated border border-border rounded-full text-text-secondary">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>
          
          <!-- Thumbnail -->
          {thumbnail && (
            <div class="reveal mb-8 aspect-video rounded-xl overflow-hidden border border-border bg-dark-elevated">
              <img 
                src={thumbnail} 
                alt={title}
                class="w-full h-full object-cover"
              />
            </div>
          )}
          
          <!-- Features -->
          {features && features.length > 0 && (
            <div class="reveal mb-8">
              <h2 class="text-xl font-semibold text-text-primary mb-4">Key Features</h2>
              <ul class="space-y-2">
                {features.map((feature) => (
                  <li class="flex items-start gap-3 text-text-secondary">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber mt-2 flex-shrink-0"></span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          <!-- README excerpt -->
          <div class="reveal prose prose-invert prose-amber max-w-none">
            <Content />
          </div>
          
          <!-- CTA -->
          <div class="reveal mt-12 pt-8 border-t border-border flex flex-wrap gap-4">
            {liveDemo && (
              <a 
                href={liveDemo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 bg-dark-surface border border-amber text-amber font-medium rounded-lg hover:bg-amber hover:text-dark transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Live Demo
              </a>
            )}
            <a 
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-amber text-dark font-medium rounded-lg hover:bg-amber-hover transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              View Full README on GitHub
            </a>
          </div>
        </div>
        
        <!-- Sidebar -->
        <div class="reveal lg:col-span-1" style="transition-delay: 100ms;">
          <div class="sticky top-24 space-y-6">
            <div class="bg-dark-surface border border-border rounded-xl p-6">
              <h3 class="text-sm font-semibold text-text-primary mb-4">Project Details</h3>
              
              <div class="space-y-3 text-sm">
                {status && status !== "Unknown" && (
                  <div class="flex items-center justify-between">
                    <span class="text-text-muted">Status</span>
                    <span class={`px-2 py-0.5 rounded text-xs ${
                      status === "Active" ? "text-green-400 bg-green-500/10" :
                      status === "Complete" ? "text-amber bg-amber/10" :
                      "text-text-muted bg-dark-elevated"
                    }`}>
                      {status}
                    </span>
                  </div>
                )}
                
                {stars > 0 && (
                  <div class="flex items-center justify-between">
                    <span class="text-text-muted">Stars</span>
                    <span class="text-text-secondary flex items-center gap-1">
                      <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      {stars}
                    </span>
                  </div>
                )}
                
                {language && (
                  <div class="flex items-center justify-between">
                    <span class="text-text-muted">Language</span>
                    <span class="text-text-secondary">{language}</span>
                  </div>
                )}
                
                <div class="flex items-center justify-between">
                  <span class="text-text-muted">Category</span>
                  <span class="text-text-secondary">{category}</span>
                </div>
              </div>
              
              {techStack && techStack.length > 0 && (
                <div class="mt-4 pt-4 border-t border-border">
                  <h4 class="text-xs font-medium text-text-muted mb-2">Tech Stack</h4>
                  <div class="flex flex-wrap gap-1.5">
                    {techStack.map((tech) => (
                      <span class="px-2 py-1 text-xs bg-dark-elevated border border-border rounded text-text-muted">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              
              {tags && tags.length > 0 && (
                <div class="mt-4 pt-4 border-t border-border">
                  <h4 class="text-xs font-medium text-text-muted mb-2">Topics</h4>
                  <div class="flex flex-wrap gap-1.5">
                    {tags.map((tag) => (
                      <span class="px-2 py-1 text-xs bg-dark-elevated border border-border rounded text-text-muted">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
